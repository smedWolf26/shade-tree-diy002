{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shade-tree-diy-api",
  "main": "src/index.js",
  "compatibility_date": "2026-03-14",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,https://shade-tree-diy.smedina-lambda.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shade-tree-diy",
      "database_id": "7f1b6431-26f1-460b-9df5-0af6b5c97f86",
      "migrations_dir": "./src/data/migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
}
